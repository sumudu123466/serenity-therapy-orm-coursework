<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane prefWidth="1300"
            prefHeight="800"

            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.TherapistController"

            style="-fx-background-color:#111827;">

    <top>

        <HBox style="-fx-padding:20;">

            <Label text="Therapist Management"

                   style="-fx-text-fill:white;
                          -fx-font-size:30;
                          -fx-font-weight:bold;"/>

        </HBox>

    </top>

    <center>

        <VBox spacing="25"
              style="-fx-padding:20;">

            <HBox spacing="20">

                <VBox spacing="15">

                    <Label text="Therapist Details"
                           style="-fx-text-fill:#E5E7EB; -fx-font-size:14; -fx-font-weight:bold;"/>

                    <TextField fx:id="txtTherapistId"
                               promptText="Therapist ID"
                               prefWidth="250"/>

                    <TextField fx:id="txtName"
                               promptText="Therapist Name"
                               prefWidth="250"/>

                    <TextField fx:id="txtSpecialization"
                               promptText="Specialization"
                               prefWidth="250"/>

                </VBox>

                <VBox spacing="15">

                    <Label text="Assignment"
                           style="-fx-text-fill:#E5E7EB; -fx-font-size:14; -fx-font-weight:bold;"/>

                    <ComboBox fx:id="cmbProgram"
                              promptText="Assign Program"
                              prefWidth="250"/>

                    <ComboBox fx:id="cmbAvailability"
                              promptText="Availability"
                              prefWidth="250"/>

                </VBox>

            </HBox>

            <HBox spacing="15">

                <Button text="SAVE"
                        onAction="#saveTherapist"
                        prefWidth="120"
                        styleClass="action-btn"/>

                <Button text="UPDATE"
                        onAction="#updateTherapist"
                        prefWidth="120"
                        styleClass="action-btn"/>

                <Button text="DELETE"
                        onAction="#deleteTherapist"
                        prefWidth="120"
                        styleClass="action-btn"/>

            </HBox>

            <TableView fx:id="tblTherapist" prefHeight="500">

                <columns>

                    <TableColumn fx:id="colId" text="ID"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colName" text="Name"
                                 prefWidth="220"/>

                    <TableColumn fx:id="colSpecialization" text="Specialization"
                                 prefWidth="250"/>

                    <TableColumn fx:id="colProgram" text="Program"
                                 prefWidth="220"/>

                    <TableColumn fx:id="colAvailability" text="Availability"
                                 prefWidth="180"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>