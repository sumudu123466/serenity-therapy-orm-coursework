<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane prefWidth="900"
            prefHeight="500"

            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"

            style="-fx-background-color:#111827;">

    <children>

        <VBox alignment="CENTER"
              spacing="25"

              layoutX="250"
              layoutY="150">

            <Label text="SERENITY THERAPY CENTER"

                   style="-fx-text-fill:white;
                          -fx-font-size:34;
                          -fx-font-weight:bold;"/>

            <ProgressIndicator/>

            <Label text="Loading System..."

                   style="-fx-text-fill:#D1D5DB;
                          -fx-font-size:16;"/>

        </VBox>

    </children>

</AnchorPane>