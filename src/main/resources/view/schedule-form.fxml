<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane prefWidth="1300"
             prefHeight="800"
             xmlns="http://javafx.com/javafx/21"
             xmlns:fx="http://javafx.com/fxml/1"
             fx:controller="controller.ScheduleController"
             style="-fx-background-color:#111827;">

    <top>

        <HBox style="-fx-padding:20;">

            <Label text="Therapy Session Scheduling"

                   style="-fx-text-fill:white;
                          -fx-font-size:30;
                          -fx-font-weight:bold;"/>

        </HBox>

    </top>

    <center>

        <VBox spacing="25"
              style="-fx-padding:20;">

            <HBox spacing="20">

                <VBox spacing="15">

                    <Label text="Session Setup"
                           style="-fx-text-fill:#E5E7EB; -fx-font-size:14; -fx-font-weight:bold;"/>

                    <TextField fx:id="txtSessionId" promptText="Session ID"
                               prefWidth="250"/>

                    <ComboBox fx:id="cmbPatient" promptText="Select Patient"
                              prefWidth="250"/>

                    <ComboBox fx:id="cmbTherapist" promptText="Select Therapist"
                              prefWidth="250"/>

                </VBox>

                <VBox spacing="15">

                    <Label text="Date &amp; Time"
                           style="-fx-text-fill:#E5E7EB; -fx-font-size:14; -fx-font-weight:bold;"/>

                    <DatePicker fx:id="dpSessionDate" promptText="Session Date" prefWidth="250"/>

                    <TextField fx:id="txtSessionTime" promptText="Time"
                               prefWidth="250"/>

                    <ComboBox fx:id="cmbProgram" promptText="Program"
                              prefWidth="250"/>

                </VBox>

            </HBox>

            <HBox spacing="15">

                <Button text="BOOK"
                        prefWidth="120"
                        onAction="#bookSession"
                        styleClass="action-btn"/>

                <Button text="UPDATE"
                        prefWidth="120"
                        onAction="#updateSession"
                        styleClass="action-btn"/>

                <Button text="CANCEL"
                        prefWidth="120"
                        onAction="#deleteSession"
                        styleClass="action-btn"/>

                <Button text="CLEAR"
                        prefWidth="120"
                        onAction="#clearForm"
                        styleClass="action-btn"/>

            </HBox>
                        onAction="#updateSession"

            <TableView fx:id="tblSession" prefHeight="500">

                <columns>
                        onAction="#deleteSession"

                    <TableColumn fx:id="colSessionId" text="Session ID"
                                 prefWidth="140"/>

                        onAction="#clearForm"
                    <TableColumn fx:id="colPatient" text="Patient"
                                 prefWidth="200"/>

                    <TableColumn fx:id="colTherapist" text="Therapist"
                                 prefWidth="200"/>

                    <TableColumn fx:id="colDate" text="Date"
                                 prefWidth="160"/>

                    <TableColumn fx:id="colTime" text="Time"
                                 prefWidth="140"/>

                    <TableColumn fx:id="colProgram" text="Program"
                                 prefWidth="220"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>