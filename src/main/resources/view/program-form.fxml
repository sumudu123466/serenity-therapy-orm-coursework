<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane prefWidth="1200"
            prefHeight="750"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ProgramController"
            style="-fx-background-color:#111827;">

    <top>

        <HBox style="-fx-padding:20;">

            <Label text="Program Management"

                   style="-fx-text-fill:white;
                          -fx-font-size:30;
                          -fx-font-weight:bold;"/>

        </HBox>

    </top>

    <center>

        <VBox spacing="20"
              style="-fx-padding:20;">

            <HBox spacing="20">

                <VBox spacing="15">

                    <Label text="Program Basics"
                           style="-fx-text-fill:#E5E7EB; -fx-font-size:14; -fx-font-weight:bold;"/>

                    <TextField fx:id="txtProgramId" promptText="Program ID"
                               prefWidth="250"/>

                    <TextField fx:id="txtProgramName" promptText="Program Name"
                               prefWidth="250"/>

                    <TextField fx:id="txtDuration" promptText="Duration"
                               prefWidth="250"/>

                </VBox>

                <VBox spacing="15">

                    <Label text="Pricing &amp; Description"
                           style="-fx-text-fill:#E5E7EB; -fx-font-size:14; -fx-font-weight:bold;"/>

                    <TextField fx:id="txtFee" promptText="Fee"
                               prefWidth="250"/>

                    <TextArea fx:id="txtDescription" promptText="Description"
                              prefWidth="250"
                              prefHeight="120"/>

                </VBox>

            </HBox>

            <HBox spacing="15">

                <Button text="SAVE"
                        prefWidth="120"
                        onAction="#saveProgram"
                        styleClass="action-btn"/>

                <Button text="UPDATE"
                        prefWidth="120"
                        onAction="#updateProgram"
                        styleClass="action-btn"/>

                <Button text="DELETE"
                        prefWidth="120"
                        onAction="#deleteProgram"
                        styleClass="action-btn"/>

                <Button text="CLEAR"
                        prefWidth="120"
                        onAction="#clearForm"
                        styleClass="action-btn"/>

            </HBox>

            <TableView fx:id="tblProgram" prefHeight="450">

                <columns>

                    <TableColumn fx:id="colProgramId" text="Program ID"
                                 prefWidth="150"/>

                    <TableColumn fx:id="colProgramName" text="Program Name"
                                 prefWidth="250"/>

                    <TableColumn fx:id="colDuration" text="Duration"
                                 prefWidth="180"/>

                    <TableColumn fx:id="colFee" text="Fee"
                                 prefWidth="180"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>